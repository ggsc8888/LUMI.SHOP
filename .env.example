# Copy to .env.local and fill in. Never commit real values.

# --- Required ---
# Random string used to sign browser sessions. Generate: openssl rand -base64 32
AUTH_SECRET=
# Key used to encrypt stored Shopify tokens (falls back to AUTH_SECRET).
APP_ENCRYPTION_KEY=
# Public URL of the app, e.g. https://your-app.vercel.app (defaults to the request origin).
APP_URL=

# --- Database (libSQL / Turso). Defaults to a local file: local.db ---
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Shopify app (Partner Dashboard -> your app -> Client credentials) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Optional
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=write_products,write_inventory,read_locations,write_files
SHOPIFY_INSTALL_URL=

# --- AI. On Vercel the AI Gateway works with no key (OIDC). Otherwise set one of these. ---
AI_GATEWAY_API_KEY=
# Direct providers (optional; used instead of the gateway when set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model overrides (optional)
TEXT_MODEL=
TEXT_MODEL_VISION=
VISION_MODEL=
CLAUDE_MODEL=
IMAGE_MODEL=
NEXT_PUBLIC_SAM_MODEL=

# Folder with the brand-voice skill (SKILL.md + references/*.md). Defaults to skills/holly-zhang
HOLLY_SKILL_DIR=
